	main.go_view("mini")
	var info: Dictionary = main.link.send("hintinfo mini")
	check(info.get("where", "") == "later" and int(info.get("puzzle", 0)) == 1, "the small board's hint says it is not ready (%s)" % info.get("where", ""))
	main._show_hint()
	await shot("hint_later")
	main._close_panel()
	# A lighthouse game saved in another room's view continues in the lighthouse.
	main.start_new("light")
	main._close_panel()
	main.view = "C2"
	main._save()
	main.continue_game("light")
	check(main.view == "L1", "a saved view of another room is not restored (%s)" % main.view)
	for id in ["hut", "light", "obs", "orangery", "theatre", "chess", "beach", "train", "alch", "attic", "watch", "museum", "tree", "gondola", "praline", "toyshop", "zeppelin", "ship", "polar", "house1905", "house1938", "house1969", "housenow", "press", "magic", "noir", "filter", "railway", "mill"]:
