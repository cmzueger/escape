## A lock or dial of a kit room, from where it stands to `code`.
func kit_dial(lock: String, code: Array, size: int = 10) -> void:
	for i in range(code.size()):
		tap("%s_up%d" % [lock, i], (int(code[i]) - int(main.st[lock][i]) + size) % size)


func _finish(name: String) -> void:
	check(main.st["done"], name + ": solved")
	explore("solved")
	await create_timer(3.0).timeout
