func dial_to(dial: String, i: int, value: int) -> void:
	var now := int(main.st[dial][i])
	while now < value:
		tap("%s_up%d" % [dial, i])
		now += 1
	while now > value:
		tap("%s_down%d" % [dial, i])
		now -= 1


